# Copy to .env and fill in real values. NEVER commit .env.
# No real secrets are in this file — only placeholders.

# Public URL of this server (Railway / Render / Fly domain, or ngrok https URL for local testing)
# Used to build the wss:// ConversationRelay URL and all TwiML action URLs.
PUBLIC_URL=https://your-app.railway.app

# Business identity — spoken in the greeting, the transfer whisper, and SMS summaries.
BUSINESS_NAME=Your Business Name

# Optional: the owner's first name, so callers asking for them by name are
# recognised by the transfer fast-path. Leave blank to match role words only.
OWNER_FIRST_NAME=

# Optional: comma-separated words the speech recogniser should bias toward
# (business name, location names, product names). Defaults to BUSINESS_NAME.
STT_HINTS=

# Twilio — from twilio.com/console (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Twilio phone number you buy for the AI to answer. Callers reach it
# directly, or by forwarding your existing business line to it (see README).
# E.164 format: +1 plus 10 digits.
TWILIO_NUMBER=+1XXXXXXXXXX

# Your existing public business line (E.164), if you forward it to the
# Twilio number with unconditional forwarding (*72). Used ONLY as a loop
# guard: the server refuses to warm-transfer a call back to this number
# while it forwards to Twilio, because that would loop forever. Leave
# blank if callers dial the Twilio number directly and no forwarding
# is in place.
BUSINESS_NUMBER=+1XXXXXXXXXX

# The owner's personal mobile — SMS summaries go here, and warm transfer
# defaults here. E.164 format: +1 plus 10 digits. Fill this in to go live;
# the code will not transfer or text anyone until this is set.
PERSONAL_MOBILE=+1XXXXXXXXXX

# TRANSFER_NUMBER — the ONE place to change where warm transfers ring.
# Defaults to PERSONAL_MOBILE if left blank. Must be a DIRECT number that
# does NOT forward to Twilio.
# ⚠️ LOOP WARNING: NEVER set this to BUSINESS_NUMBER while that number
# forwards (*72) to Twilio — Twilio dialling it would bounce straight
# back to Twilio and the owner would never get the call. The server
# refuses that number (and the Twilio number itself) and takes a message
# instead. See README "The transfer loop warning".
# A common working setup: both lines on one dual-SIM handset — the
# business line forwards to Twilio, the personal line does not, so
# transferring to the personal number rings the same phone, with no loop.
TRANSFER_NUMBER=+1XXXXXXXXXX

# LLM provider: gemini (default) or openai. Set only the key for the provider you use.
# Gemini — FREE key at aistudio.google.com/apikey (Google account, no card needed for free tier).
# Model gemini-3.5-flash-lite: $0.30/1M input tokens, $2.50/1M output tokens on the paid tier.
# Free-tier prompts may be used by Google to improve its products; enable billing for paid-tier terms.
# LATENCY: on the free tier, first-token latency measured 5-12s per turn in
# production (Nov 2026) — too slow for a phone call. Enabling billing on the
# project (paid tier, same key, no code change) fixed it. See README "Latency".
# Do NOT use gemini-2.5-flash: Google restricted it to projects that had already
# actively used it (Sept 2026), so new projects get a bare HTTP 404 with no error
# body. See README "Troubleshooting".
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini OpenAI-compatible endpoint — do not change unless Google moves it.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI fallback — only if LLM_PROVIDER=openai. From platform.openai.com/api-keys.
# Text model used with ConversationRelay (text in / text out). Do not use a
# realtime speech-to-speech model here — see README "Architecture".
# NOTE: OpenAI retires gpt-4o-mini from the API on Jan 14, 2027; its
# replacement is gpt-6-luna (set OPENAI_MODEL=gpt-6-luna, no code change).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Business hours for warm transfer. Outside these hours: message only.
# Times are 24-hour HH:MM in TIMEZONE (IANA name, daylight-saving safe).
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=17:00
TIMEZONE=America/New_York

# Warm transfer: seconds to wait for the owner to press 1 before falling back to a message.
TRANSFER_TIMEOUT_SECONDS=25
# Whisper: seconds the owner has to press 1 after hearing the summary.
WHISPER_TIMEOUT_SECONDS=10

# Server port (Railway/Render set PORT automatically; local default is 3000)
PORT=3000
